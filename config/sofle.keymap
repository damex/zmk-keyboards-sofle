#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define FN1 1
#define FN2 2
#define SET 3

/ {
	conditional_layers {
		compatible = "zmk,conditional-layers";
		set_layer {
			if-layers = <FN1 FN2>;
			then-layer = <SET>;
		};
	};

	keymap {
		compatible = "zmk,keymap";
		default_layer {
			display-name = "base";
// | ESC |  1  |  2  |  3  |  4  |  5  |               |  6  |  7  |  8  |  9  |  0  | BKSP |
// | TAB |  Q  |  W  |  E  |  R  |  T  |               |  Y  |  U  |  I  |  O  |  P  |      |
// | CTRL|  A  |  S  |  D  |  F  |  G  |               |  H  |  J  |  K  |  L  |  ;  |  '   |
// |SHIFT|  Z  |  X  |  C  |  V  |  B  | MUTE | | MUTE |  N  |  M  |  ,  |  .  |  /  |      |
//       |     |     | WIN | ALT | SPC |               | RET | FN1 | FN2 |     |     |
			bindings = <
&kp ESC        &kp N1     &kp N2     &kp N3     &kp N4     &kp N5                            &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp BSPC
&kp TAB        &kp Q      &kp W      &kp E      &kp R      &kp T                             &kp Y      &kp U      &kp I      &kp O      &kp P      &kp LBKT
&kp LCTRL      &kp A     &kp S      &kp D      &kp F      &kp G                             &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
&kp LSHFT      &kp Z      &kp X      &kp C      &kp V      &kp B      &kp C_MUTE &kp C_MUTE  &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RBKT
               &none      &none      &kp LGUI   &kp LALT   &kp SPACE                         &kp RET    &mo FN1    &mo FN2    &none      &none
			>;
			sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
		};

		fn1_layer {
			display-name = "fn1";
			bindings = <
&kp GRAVE      &trans     &trans     &trans     &trans     &trans                            &trans     &trans     &trans     &trans     &trans     &kp DEL
&trans         &trans     &trans     &trans     &trans     &trans                            &trans     &trans     &trans     &trans     &trans     &trans
&trans         &trans     &trans     &trans     &trans     &trans                            &kp HOME   &kp UP     &kp END    &kp PG_UP  &trans     &trans
&trans         &trans     &trans     &trans     &trans     &trans     &trans     &trans      &kp LEFT   &kp DOWN   &kp RIGHT  &kp PG_DN  &trans     &trans
               &trans     &trans     &trans     &trans     &trans                            &trans     &trans     &trans     &trans     &trans
			>;
		};

		fn2_layer {
			display-name = "fn2";
			bindings = <
&trans         &trans     &trans     &trans     &trans     &trans                            &trans     &trans     &trans     &trans     &trans     &trans
&trans         &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT                         &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR   &trans
&trans         &kp EQUAL  &kp PLUS   &kp MINUS  &kp UNDER  &kp PIPE                          &kp BSLH   &kp LBRC   &kp RBRC   &kp LBKT   &kp RBKT   &trans
&trans         &kp GRAVE  &kp TILDE  &kp LT     &kp GT     &kp QMARK  &trans     &trans      &kp FSLH   &kp COLON  &kp SEMI   &kp DQT    &kp SQT    &trans
               &trans     &trans     &trans     &trans     &trans                            &trans     &trans     &trans     &trans     &trans
			>;
		};

		set_layer {
			display-name = "set";
			bindings = <
&kp ESC        &kp F1     &kp F2     &kp F3     &kp F4     &kp F5                            &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &trans
&bootloader    &kp F11    &kp F12    &trans     &trans     &trans                            &trans     &trans     &trans     &trans     &kp PSCRN  &bootloader
&trans         &trans     &trans     &trans     &trans     &trans                            &trans     &trans     &trans     &trans     &trans     &trans
&trans         &trans     &trans     &trans     &trans     &trans     &trans     &trans      &trans     &trans     &trans     &trans     &trans     &trans
               &trans     &trans     &trans     &trans     &trans                            &trans     &trans     &trans     &trans     &trans
			>;
		};
	};
};
